{
    "name": "kuroshiro-analyzer-kuromoji",
    "version": "2.0.0-beta.1",
    "description": "kuromoji morphological analyzer for kuroshiro",
    "main": "index.js",
    "module": "src/index.js",
    "types": "index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "lib",
        "dist",
        "src"
    ],
    "browser": "dist/kuroshiro-analyzer-kuromoji.mjs",
    "scripts": {
        "lint": "eslint src test scripts index.js *.mjs",
        "lint:fix": "npm run lint -- --fix",
        "jest": "jest --verbose",
        "jest:watch": "npm run jest -- --watch",
        "jest:coverage": "jest --verbose --coverage",
        "test:package": "node test/package-smoke.cjs",
        "test:types": "tsc --project tsconfig.json && node test/types.cjs",
        "test": "npm run lint && npm run jest && npm run build && npm run test:package && npm run test:types",
        "clean": "rimraf lib dist",
        "build": "npm run clean && npm run build:cjs && npm run build:browser && npm run build:umd && npm run build:umd:min",
        "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir lib",
        "build:browser": "vite build --mode browser",
        "build:umd": "vite build",
        "build:umd:min": "vite build --mode minify",
        "prepack": "npm run build"
    },
    "keywords": [
        "kuroshiro",
        "morphology",
        "analyzer",
        "kuromoji",
        "japanese",
        "language",
        "kanji",
        "hiragana",
        "katakana",
        "romaji",
        "kana"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji.git"
    },
    "author": "Hexen Qi",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji/issues"
    },
    "homepage": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "tag": "beta"
    },
    "dependencies": {
        "kuromoji": "^0.1.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "acorn": "^8.18.0",
        "babel-jest": "^30.5.2",
        "babel-plugin-add-module-exports": "^1.0.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "jsdom": "^30.1.1",
        "path-browserify": "^1.0.1",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "vite": "^8.3.1"
    },
    "jest": {
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        },
        "testEnvironment": "node",
        "testMatch": [
            "**/test/**/*.spec.js"
        ]
    }
}
