{
    "name": "kuroshiro-analyzer-kuromoji",
    "version": "1.1.0",
    "description": "kuromoji morphological analyzer for kuroshiro",
    "main": "index.js",
    "module": "src/index.js",
    "files": [
        "index.js",
        "lib",
        "dist",
        "src"
    ],
    "browser": {
        "./src/dict-path.js": "./src/dict-path.browser.js",
        "./lib/dict-path.js": "./lib/dict-path.browser.js"
    },
    "scripts": {
        "lint": "eslint src test scripts index.js *.mjs",
        "lint:fix": "npm run lint -- --fix",
        "jest": "jest --verbose",
        "jest:watch": "npm run jest -- --watch",
        "jest:coverage": "jest --verbose --coverage",
        "test:package": "node test/package-smoke.cjs",
        "test": "npm run lint && npm run jest && npm run build && npm run test:package",
        "clean": "rimraf lib dist",
        "build": "npm run clean && npm run build:cjs && npm run build:umd && npm run build:umd:min",
        "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir lib",
        "build:umd": "vite build",
        "build:umd:min": "vite build --mode minify",
        "prepack": "npm run build"
    },
    "keywords": [
        "kuroshiro",
        "morphology",
        "analyzer",
        "kuromoji",
        "japanese",
        "language",
        "kanji",
        "hiragana",
        "katakana",
        "romaji",
        "kana"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji.git"
    },
    "author": "Hexen Qi",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji/issues"
    },
    "homepage": "https://github.com/hexenq/kuroshiro-analyzer-kuromoji",
    "dependencies": {
        "kuromoji": "^0.1.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "acorn": "^8.18.0",
        "babel-jest": "^30.5.1",
        "babel-plugin-add-module-exports": "^1.0.4",
        "cross-env": "^10.1.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "jsdom": "^26.1.0",
        "path-browserify": "^1.0.1",
        "rimraf": "^6.1.3",
        "vite": "^8.3.0"
    },
    "jest": {
        "transform": {
            "^.+\\.jsx?$": "babel-jest"
        },
        "testEnvironment": "node",
        "testMatch": [
            "**/test/**/*.spec.js"
        ]
    }
}
